{
  "global": {
    "k6Dir": "bin/k6",
    "nodeDir": "bin/node"
  },
  "main": {
    "url": "http://localhost:3000",
    "logDir": "logs/main"
  },
  "test": {
    "initVUs": 1,
    "maxVUs": 400,
    "duration": "6s",
    "minErrorRate": 0.05,
    "maxResponseTime": 2000,
    "iterations": 30,
    "logDir": "logs/test",
    "dataOutputDir": "data/test",
    "scriptDir": "scripts/test_scripts",
    "testScript": "stepped_load_test.js",
    "filterZeroValues": true,
    "filterInvalidValues": true
  },
  "server": {
    "serverUrl": "http://localhost:10000",
    "controlUrl": "http://localhost:10001",
    "mode": "cluster",
    "workers": 16,
    "logDir": "logs/server",
    "express": {
      "logDir": "logs/express_service"
    }
  },
  "monitor": {
    "logDir": "logs/monitor",
    "dataReportDir": "data/monitor",
    "monitorInterval": 1000,
    "dataRetention": 86400000,
    "monitorMode": "tail",
    "algorithm": "doubleWindow",
    "batchSize": 5,
    "maxHistoryPoints": 300
  },
  "analyzer": {
    "logDir": "logs/analyzer",
    "dataReportDir": "data/analyzer",
    "reportDir": "reports",
    "strategyDir": "scripts/analyze_strategy",
    "analysisStrategy": "DoubleWindowStrategy.js"
  },
  "strategies": {
    "DoubleWindowStrategy": { "windowSize": 15, "optimalThreshold": 3.5, "maxThreshold": 8.0, "sustainCount": 3, "minDataPoints": 30 },
    "CusumStrategy": { "baselinePoints": 30, "cMultiplier": 0.5, "optimalHMultiplier": 3.0, "maxHMultiplier": 6.0, "minDataPoints": 30 },
    "SlopeChangeStrategy": { "windowSize": 15, "optimalSlopeMultiplier": 2.0, "maxSlopeMultiplier": 4.0, "sustainCount": 3, "minDataPoints": 30 },
    "postProcess": { "enabled": true, "optimalMultiplier": 4.0, "maxBaselineRatio": 10.0, "maxOptimalRatio": 2.5, "optimalMinResourceLoad": 90.0, "maxMinResourceLoad": 80.0, "maxErrorRateThreshold": 1.0 },
    "optimalMinResourceLoad": 95.0,
    "optimalMinResourceLoadByTarget": { "memory": 50.0 },
    "maxErrorRateThreshold": 1.0,
    "maxErrorRateTrendWindow": 5
  }
}
