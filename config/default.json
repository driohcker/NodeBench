{
  "global": {
    "k6Dir": "bin/k6",
    "nodeDir": "bin/node"
  },
  "main": {
    "url": "http://localhost:3000",
    "logDir": "logs/main"
  },
  "server": {
    "serverUrl": "http://localhost:10000",
    "controlUrl": "http://localhost:10001",
    "mode": "cluster",
    "workers": 16,
    "logDir": "logs/server",
    "express": {
      "logDir": "logs/express_service"
    }
  },
  "test": {
    "logDir": "logs/test",
    "dataOutputDir": "data/test",
    "outputMode": "file",
    "testTargets": ["cpu"],
    "initVUs": 1,
    "maxVUs": 400,
    "duration": "6s",
    "iterations": 30,
    "waitPeriod": 5,
    "maxVuIncrement": 100,
    "metricFilters": ["vus", "http_reqs", "http_req_duration"]
  },
  "monitor": {
    "logDir": "logs/monitor",
    "dataReportDir": "data/monitor_reports",
    "monitorInterval": 200,
    "monitorMode": "tail",
    "algorithm": "doubleWindow",
    "windowSize": 10,
    "threshold": 1.5,
    "sustainCount": 3,
    "minDataPoints": 20,
    "batchSize": 5,
    "baselinePoints": 20,
    "kMultiplier": 0.5,
    "hMultiplier": 4.0,
    "slopeThreshold": 0.3,
    "maxHistoryPoints": 300
  },
  "analyzer": {
    "logDir": "logs/analyzer",
    "dataReportDir": "data/analyzer_reports",
    "benchmarkReportDir": "data/analyzer_reports",
    "reportDir": "reports",
    "dataDir": "data",
    "strategyDir": "scripts/analyze_strategy",
    "analysisStrategy": "DoubleWindowStrategy.js"
  }
}
