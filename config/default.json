{
  "global": {
    "k6Dir": "bin/k6",
    "nodeDir": "bin/node"
  },
  "main": {
    "url": "http://localhost:3000",
    "logDir": "logs/main"
  },
  "server": {
    "serverUrl": "http://localhost:10000",
    "controlUrl": "http://localhost:10001",
    "mode": "cluster",
    "workers": 16,
    "logDir": "logs/server",
    "express": {
      "logDir": "logs/express_service"
    }
  },
  "test": {
    "logDir": "logs/test",
    "dataOutputDir": "data/test",
    "outputMode": "file",
    "testTargets": ["cpu"],
    "initVUs": 1,
    "maxVUs": 400,
    "duration": "6s",
    "iterations": 30,
    "waitPeriod": 5,
    "maxVuIncrement": 100,
    "metricFilters": ["vus", "http_reqs", "http_req_duration"],
    "filterZeroValues": true
  },
  "monitor": {
    "logDir": "logs/monitor",
    "dataReportDir": "data/monitor",
    "monitorInterval": 200,
    "monitorMode": "tail",
    "algorithm": "doubleWindow",
    "batchSize": 5,
    "maxHistoryPoints": 300
  },
  "analyzer": {
    "logDir": "logs/analyzer",
    "dataReportDir": "data/analyzer",
    "reportDir": "reports",
    "strategyDir": "scripts/analyze_strategy",
    "analysisStrategy": "DoubleWindowStrategy.js"
  },
  "strategies": {
    "DoubleWindowStrategy": {
      "windowSize": 10,
      "threshold": 1.5,
      "sustainCount": 3,
      "minDataPoints": 20
    },
    "CusumStrategy": {
      "baselinePoints": 20,
      "cMultiplier": 0.5,
      "HMultiplier": 4.0,
      "minDataPoints": 20
    },
    "SlopeChangeStrategy": {
      "windowSize": 15,
      "slopeThreshold": 0.3,
      "sustainCount": 2,
      "minDataPoints": 30
    }
  }
}
