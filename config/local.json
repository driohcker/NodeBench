{
  "server": {
    "controlUrl": "http://localhost:10002",
    "express": {
      "workers": 16,
      "mode": "cluster"
    }
  },
  "test": {
    "iterations": 20,
    "outputMode": "pipe",
    "testTargets": [
      "cpu"
    ],
    "initVUs": 1,
    "maxVUs": 2000,
    "thinkTime": 0.1,
    "spikeFilter": {
      "metrics": [
        "http_reqs",
        "http_req_duration"
      ],
      "windowSize": 20,
      "minHistory": 20,
      "enabled": false,
      "threshold": 10,
      "minAbsoluteThreshold": 100
    }
  },
  "monitor": {
    "algorithm": "doubleWindow",
    "monitorMode": "pipe",
    "batchSize": 30
  },
  "strategies": {
    "DoubleWindowStrategy": {
      "windowSize": 15,
      "optimalThreshold": 3.5,
      "maxThreshold": 8,
      "sustainCount": 3,
      "minDataPoints": 30,
      "optimalMinResourceLoad": 0,
      "postProcess": {
        "enabled": true,
        "optimalMultiplier": 4,
        "maxBaselineRatio": 10,
        "maxOptimalRatio": 2.5,
        "optimalMinRatio": 0.15,
        "optimalMaxRatio": 0.35,
        "maxMinRatio": 0.55,
        "maxMaxRatio": 0.8,
        "optimalMinResourceLoad": 0,
        "maxMinResourceLoad": 0,
        "maxErrorRateThreshold": 1
      }
    },
    "CusumStrategy": {
      "windowSize": 15,
      "optimalRatio": 3.5,
      "maxRatio": 8,
      "sustainCount": 3,
      "minDataPoints": 30,
      "optimalMinResourceLoad": 0,
      "postProcess": {
        "enabled": true,
        "optimalMultiplier": 4,
        "maxBaselineRatio": 10,
        "maxOptimalRatio": 2.5,
        "optimalMinRatio": 0.15,
        "optimalMaxRatio": 0.35,
        "maxMinRatio": 0.55,
        "maxMaxRatio": 0.8,
        "optimalMinResourceLoad": 0,
        "maxMinResourceLoad": 0,
        "maxErrorRateThreshold": 1
      }
    },
    "SlopeChangeStrategy": {
      "windowSize": 15,
      "optimalSlopeMultiplier": 2,
      "maxSlopeMultiplier": 4,
      "sustainCount": 3,
      "minDataPoints": 30,
      "optimalMinResourceLoad": 0,
      "postProcess": {
        "enabled": true,
        "optimalMultiplier": 4,
        "maxBaselineRatio": 10,
        "maxOptimalRatio": 2.5,
        "optimalMinRatio": 0.15,
        "optimalMaxRatio": 0.35,
        "maxMinRatio": 0.55,
        "maxMaxRatio": 0.8,
        "optimalMinResourceLoad": 0,
        "maxMinResourceLoad": 0,
        "maxErrorRateThreshold": 1
      }
    }
  }
}
