{
  "server": {
    "controlUrl": "http://localhost:10002",
    "express": {
      "workers": 16,
      "mode": "cluster"
    }
  },
  "test": {
    "iterations": 20,
    "outputMode": "pipe",
    "testTargets": [
      "cpu"
    ]
  },
  "monitor": {
    "algorithm": "doubleWindow",
    "monitorMode": "pipe",
    "batchSize": 30
  },
  "strategies": {
    "DoubleWindowStrategy": {
      "windowSize": 10,
      "threshold": 1.3,
      "sustainCount": 3,
      "minDataPoints": 20
    },
    "CusumStrategy": {
      "baselinePoints": 20,
      "minDataPoints": 25
    },
    "SlopeChangeStrategy": {
      "windowSize": 20,
      "slopeThreshold": 1,
      "minDataPoints": 25,
      "sustainCount": 3
    }
  }
}
