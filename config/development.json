{
  "global": {
    "k6Dir": "bin/k6",
    "nodeDir": "bin/node"
  },
  "main": {
    "url": "http://localhost:3000",
    "logDir": "logs/main"
  },
  "test": {
    "initVUs": 1,
    "maxVUs": 300,
    "duration": "5s",
    "iterations": 30,
    "outputMode": "file",
    "logDir": "logs/test",
    "dataOutputDir": "data/test",
    "testTargets": ["cpu"],
    "waitPeriod": 5,
    "maxVuIncrement": 100,
    "metricFilters": ["vus", "http_reqs", "http_req_duration", "http_req_failed"],
    "filterZeroValues": true,
    "filterInvalidValues": true,
    "maxLatency": 2000,
    "maxErrorRate": 0.05
  },
  "server": {
    "logDir": "logs/server",
    "express": {
      "serverUrl": "http://localhost:10000",
      "mode": "cluster",
      "workers": 16,
      "logDir": "logs/express_service",
      "methodsDir": "scripts/server_methods"
    }
  },
  "monitor": {
    "logDir": "logs/monitor",
    "monitorInterval": 1000,
    "dataRetention": 86400000,
    "monitorMode": "tail",
    "algorithm": "cusum",
    "batchSize": 5,
    "maxHistoryPoints": 300
  },
  "analyzer": {
    "logDir": "logs/analyzer",
    "dataReportDir": "data/analyzer",
    "reportDir": "reports",
    "strategyDir": "scripts/analyze_strategy",
    "analysisStrategy": "DoubleWindowStrategy.js"
  },
  "strategies": {
    "DoubleWindowStrategy": {
      "windowSize": 10,
      "threshold": 1.3,
      "sustainCount": 3,
      "minDataPoints": 10
    },
    "CusumStrategy": {
      "baselinePoints": 15,
      "cMultiplier": 0.5,
      "HMultiplier": 4.0,
      "minDataPoints": 10
    },
    "SlopeChangeStrategy": {
      "windowSize": 15,
      "slopeThreshold": 0.3,
      "sustainCount": 2,
      "minDataPoints": 30
    }
  }
}
